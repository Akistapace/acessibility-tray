{
  "name": "@facemesh-mouse/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "build": "pnpm --filter @facemesh-mouse/shared build && tsc -p tsconfig.json && tsc --noEmit -p tsconfig.renderer.json && node scripts/buildRenderer.mjs && node scripts/copyStaticAssets.mjs",
    "dev": "pnpm run build && electron .",
    "test": "vitest run",
    "dist": "pnpm run build && electron-builder --config electron-builder.yml"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@facemesh-mouse/shared": "workspace:*",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@nut-tree-fork/nut-js": "^4.2.0",
    "@techstark/opencv-js": "5.0.0-release.1",
    "koffi": "^3.1.5"
  }
}
